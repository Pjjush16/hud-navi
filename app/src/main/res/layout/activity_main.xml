<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- HUD 镜像翻转容器 -->
    <FrameLayout
        android:id="@+id/flipContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 自研 Canvas 绘制引擎 — 所有 HUD 元素都在 Canvas 内绘制 -->
        <com.hud.navi.HudView
            android:id="@+id/hudView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- HUD 镜像切换按钮（右上角，仅交互控件留在 XML） -->
    <TextView
        android:id="@+id/btnMirror"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="🪞"
        android:textSize="20sp"
        android:background="@drawable/btn_bg"
        android:alpha="0.6"
        android:clickable="true"
        android:focusable="true" />

    <!-- 缩放控件（右侧垂直） -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/btnZoomIn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/zoomLevel"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="16"
            android:textColor="#88CCFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnZoomOut"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- 权限被拒提示（居中，默认隐藏） -->
    <LinearLayout
        android:id="@+id/permDeniedLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="需要定位权限才能使用导航"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/btnRetryPerm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="重新授权"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
