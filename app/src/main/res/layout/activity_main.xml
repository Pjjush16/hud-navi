<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- HUD 镜像翻转容器 -->
    <FrameLayout
        android:id="@+id/flipContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- MapLibre 矢量瓦片底图（OpenGL ES, 45° 倾斜） -->
        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- HUD 覆盖层（透明背景，只画车速/车标/导航信息） -->
        <com.hud.navi.HudView
            android:id="@+id/hudView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- 唤醒词反馈面板（通过 scaleY 跟随镜像同步翻转） -->
    <FrameLayout
        android:id="@+id/wakeFeedback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false">

        <!-- 底部渐变 + "我在" 文字 -->
        <LinearLayout
            android:id="@+id/wakeFeedbackPanel"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/wake_gradient_bg"
            android:translationY="120dp">

            <TextView
                android:id="@+id/wakeFeedbackText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我在"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/wakeFeedbackKeyword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#99FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 权限被拒提示（居中，默认隐藏） -->
    <LinearLayout
        android:id="@+id/permDeniedLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="需要定位权限才能使用导航"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/btnRetryPerm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="重新授权"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/btn_bg"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
