{
  "version": 8,
  "name": "HUD Dark",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet/tilejson.json"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#000000"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0a1a2a"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "filter": [
        "==",
        "class",
        "wood"
      ],
      "paint": {
        "fill-color": "#0a120a"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "filter": [
        "in",
        "class",
        "residential",
        "commercial",
        "industrial"
      ],
      "paint": {
        "fill-color": "#111111"
      }
    },
    {
      "id": "building",
      "type": "fill-extrusion",
      "source": "osm",
      "source-layer": "building",
      "paint": {
        "fill-extrusion-color": "#1a1a2a",
        "fill-extrusion-height": [
          "coalesce",
          [
            "get",
            "render_height"
          ],
          5
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "render_min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.7
      },
      "minzoom": 15
    },
