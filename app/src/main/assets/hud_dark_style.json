{
  "version": 8,
  "name": "HUD Dark",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet/tilejson.json"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#000000"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0a1a2a"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "filter": [
        "==",
        "class",
        "wood"
      ],
      "paint": {
        "fill-color": "#0a120a"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "filter": [
        "in",
        "class",
        "residential",
        "commercial",
        "industrial"
      ],
      "paint": {
        "fill-color": "#111111"
      }
    },
    {
      "id": "building",
      "type": "fill-extrusion",
      "source": "osm",
      "source-layer": "building",
      "paint": {
        "fill-extrusion-color": "#1a1a2a",
        "fill-extrusion-height": [
          "coalesce",
          [
            "get",
            "render_height"
          ],
          5
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "render_min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.7
      },
      "minzoom": 15
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "motorway"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#333300",
        "line-width": {
          "stops": [
            [
              10,
              4
            ],
            [
              14,
              12
            ],
            [
              18,
              24
            ]
          ]
        }
      }
    },
    {
      "id": "road-trunk-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "trunk"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#2a2a00",
        "line-width": {
          "stops": [
            [
              10,
              3
            ],
            [
              14,
              10
            ],
            [
              18,
              20
            ]
          ]
        }
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "primary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#222222",
        "line-width": {
          "stops": [
            [
              10,
              2.5
            ],
            [
              14,
              8
            ],
            [
              18,
              16
            ]
          ]
        }
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "motorway"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFD700",
        "line-width": {
          "stops": [
            [
              10,
              2
            ],
            [
              14,
              6
            ],
            [
              18,
              14
            ]
          ]
        }
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "trunk"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFA500",
        "line-width": {
          "stops": [
            [
              10,
              1.5
            ],
            [
              14,
              5
            ],
            [
              18,
              12
            ]
          ]
        }
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "primary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": {
          "stops": [
            [
              10,
              1.2
            ],
            [
              14,
              4
            ],
            [
              18,
              10
            ]
          ]
        }
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "secondary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#AAAAAA",
        "line-width": {
          "stops": [
            [
              10,
              0.8
            ],
            [
              14,
              3
            ],
            [
              18,
              8
            ]
          ]
        }
      }
    },
    {
      "id": "road-tertiary",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        "class",
        "tertiary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#666666",
        "line-width": {
          "stops": [
            [
              12,
              0.6
            ],
            [
              14,
              2
            ],
            [
              18,
              6
            ]
          ]
        }
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "residential",
        "unclassified"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#444444",
        "line-width": {
          "stops": [
            [
              12,
              0.4
            ],
            [
              14,
              1.5
            ],
            [
              18,
              4
            ]
          ]
        }
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name:latin}",
        "text-size": {
          "stops": [
            [
              14,
              10
            ],
            [
              18,
              14
            ]
          ]
        },
        "text-font": [
          "Noto Sans Regular"
        ]
      },
      "paint": {
        "text-color": "#999999",
        "text-halo-color": "#000000",
        "text-halo-width": 2
      }
    }
  ]
}