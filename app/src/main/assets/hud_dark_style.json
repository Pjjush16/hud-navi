      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3a3a3a",
        "line-width": {
          "stops": [[10, 6], [14, 16], [16, 24], [18, 36], [20, 46]]
        }
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3a3a3a",
        "line-width": {
          "stops": [[10, 5], [14, 14], [16, 20], [18, 30], [20, 40]]
        }
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3a3a3a",
        "line-width": {
          "stops": [[10, 4], [14, 12], [16, 18], [18, 28], [20, 36]]
        }
      }
    },
    {
      "id": "road-tertiary",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "tertiary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3a3a3a",
        "line-width": {
          "stops": [[12, 2], [14, 8], [16, 14], [18, 22], [20, 30]]
        }
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "residential", "unclassified"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3a3a3a",
        "line-width": {
          "stops": [[12, 1], [14, 4], [16, 8], [18, 14], [20, 22]]
        }
      }
    }
  ]
}
