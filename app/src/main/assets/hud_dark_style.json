{
  "version": 8,
  "name": "HUD Dark - Uniform Roads",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet/tilejson.json"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#000000"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0a1a2a"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#0a120a"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "commercial", "industrial"],
      "paint": {
        "fill-color": "#111111"
      }
    },
    {
      "id": "building",
      "type": "fill-extrusion",
      "source": "osm",
      "source-layer": "building",
      "paint": {
        "fill-extrusion-color": "#d8d8e0",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], 5],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.7
      },
      "minzoom": 15
    },

    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": {
          "stops": [[10, 10], [14, 24], [16, 36], [18, 54], [20, 68]]
        }
      }
    },
    {
      "id": "road-trunk-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "trunk"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": {
          "stops": [[10, 9], [14, 22], [16, 32], [18, 48], [20, 60]]
        }
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": {
          "stops": [[10, 8], [14, 20], [16, 28], [18, 42], [20, 52]]
        }
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": {
          "stops": [[10, 7], [14, 18], [16, 26], [18, 38], [20, 46]]
        }
      }
    },
    {
      "id": "road-tertiary-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "tertiary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": {
          "stops": [[12, 5], [14, 14], [16, 22], [18, 32], [20, 40]]
        }
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "residential", "unclassified"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": {
          "stops": [[12, 3], [14, 8], [16, 14], [18, 22], [20, 30]]
        }
      }
    },

    {
      "id": "road-motorway",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#3a3a3a",
